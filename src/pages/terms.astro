---
import Layout from '@/layouts/Layout.astro';

const title = 'Terms of Use — LabelsCrop';
const description = 'The terms for using LabelsCrop, a free browser-based label cropping and sorting tool.';
const lastUpdated = 'September 19, 2026';
---

<Layout title={title} description={description}>
	<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
		<h1 data-reveal class="text-4xl font-bold tracking-tight sm:text-5xl">Terms of Use</h1>
		<p data-reveal class="mt-2 text-sm text-muted-foreground">Last updated: {lastUpdated}</p>

		<div data-reveal class="prose prose-neutral mt-8 max-w-none text-muted-foreground dark:prose-invert">
			<h2>Using LabelsCrop</h2>
			<p>
				LabelsCrop is provided free of charge for processing your own shipping label files. By
				using this site, you agree to use it only for lawful purposes and only on files you have
				the right to process.
			</p>

			<h2>No warranty</h2>
			<p>
				LabelsCrop is provided "as is," without warranty of any kind. While we aim for accurate
				cropping, sorting, and layout, you are responsible for reviewing the preview and the
				downloaded file before using it to fulfil orders. We are not liable for shipping errors,
				misprints, or losses resulting from use of this tool.
			</p>

			<h2>Independence</h2>
			<p>
				LabelsCrop is an independent tool and is not affiliated with, endorsed by, or sponsored by
				Meesho, Amazon, Flipkart, or any courier partner named on the labels this tool processes.
				All trademarks belong to their respective owners.
			</p>

			<h2>Changes</h2>
			<p>
				We may update these terms or the tool itself at any time. Continued use of LabelsCrop after
				a change means you accept the updated terms.
			</p>

			<h2>Contact</h2>
			<p>
				Questions about these terms can be sent to the contact details listed on our
				<a href="/about">About</a> page.
			</p>
		</div>
	</section>
</Layout>
