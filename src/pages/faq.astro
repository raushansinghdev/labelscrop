---
import Layout from '@/layouts/Layout.astro';
import PageCta from '@/components/site/PageCta.astro';

const title = 'Meesho Label Cropper FAQ — LabelsCrop';
const description =
	"Answers to common questions about LabelsCrop's free Meesho label cropper: is it really free, does it work on mobile, is my data safe, and more.";

const faqs = [
	{
		q: 'Is LabelsCrop really free?',
		a: 'Yes. LabelsCrop is free forever, with no page limits, no watermark, and no account required. The site is supported by ads placed away from the upload, preview, and download flow so they never get in your way.',
	},
	{
		q: 'Do I need to create an account or sign in?',
		a: 'No. There is no login, no signup, and no email required. Open the tool, upload your PDF, and download your result.',
	},
	{
		q: 'Is my order and customer data safe?',
		a: "Your PDF is never uploaded anywhere. All cropping, sorting, and file generation happens locally in your browser using your device's own processing power — LabelsCrop has no server that ever sees your file.",
	},
	{
		q: 'Does LabelsCrop work on my phone?',
		a: 'Yes. LabelsCrop is built mobile-first and works in any modern mobile browser (Chrome, Safari, etc.), in addition to desktop and tablet.',
	},
	{
		q: 'What printer sizes are supported?',
		a: 'You can print on 3x5" and 4x6" thermal label printers, or on regular A4 paper with 1, 2, or 4 labels per sheet — with or without the invoice attached to each label.',
	},
	{
		q: 'Can I remove the tax invoice from my Meesho labels?',
		a: "Yes. Meesho prints the shipping label and tax invoice on the same page — LabelsCrop finds the split automatically and crops the invoice away. You can also keep the invoice attached, or save all the invoices as a separate PDF.",
	},
	{
		q: 'Can I sort my labels by SKU or courier?',
		a: "Yes. Sort by SKU, courier, pickup hub, color then size, or size then color — or keep Meesho's original order. You also get an SKU pick list showing how many of each item to pack.",
	},
	{
		q: 'Can I upload labels from more than one Meesho account?',
		a: 'Yes. LabelsCrop supports uploading multiple PDF files at once, so sellers running more than one account or exporting in batches can process everything together.',
	},
	{
		q: 'How many labels can I process at once?',
		a: "Because everything runs in your browser rather than on a server, the practical limit depends on your device's memory rather than any limit we impose. LabelsCrop processes large batches in chunks and will warn you before a very large upload might strain your browser.",
	},
	{
		q: 'Will Amazon or Flipkart label support be added?',
		a: "It's on the roadmap. LabelsCrop is built to support multiple platforms — Meesho is first, with Amazon and Flipkart label cropping planned as a later addition.",
	},
	{
		q: 'I found a bug or want a new feature — how do I tell you?',
		a: 'Tap "Request a feature" at the top of any page. It opens your email app with a short template — fill in what you need or what went wrong, and attach a screenshot if you can.',
	},
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.a,
		},
	})),
};
---

<Layout title={title} description={description} schema={schema}>
	<section class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-6 sm:pt-16 sm:pb-24">
		<div class="text-center">
			<p data-reveal class="inline-flex rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">FAQ</p>
			<h1 data-reveal class="mt-4 text-3xl font-bold tracking-tight text-balance sm:text-5xl">Questions, answered</h1>
			<p data-reveal class="mx-auto mt-3 max-w-xl text-base text-pretty text-muted-foreground sm:mt-4 sm:text-lg">
				The things sellers ask most — about privacy, printers, and getting labels out the door.
			</p>
		</div>

		<div class="mt-10 space-y-3 sm:mt-12">
			{faqs.map((faq, i) => (
				<details
					data-reveal
					open={i === 0}
					class="faq-item group rounded-2xl border border-border bg-card transition-[border-color,box-shadow] duration-200 open:border-primary/30 open:shadow-sm"
				>
					<summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold marker:content-none [&::-webkit-details-marker]:hidden">
						{faq.q}
						<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground transition-[transform,background-color,color] duration-300 group-open:rotate-45 group-open:bg-primary group-open:text-primary-foreground">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="h-4 w-4" aria-hidden="true">
								<path d="M12 5v14M5 12h14" />
							</svg>
						</span>
					</summary>
					<p class="px-5 pb-5 text-sm leading-relaxed text-muted-foreground sm:text-[0.95rem]">{faq.a}</p>
				</details>
			))}
		</div>

		<PageCta title="Still have a question?" text="Email us — we read every message. Or jump straight into the tool and try it with your own labels." />
	</section>
</Layout>

<style>
	/* Smooth open/close where supported (Chrome 131+); other browsers simply snap open, which is fine. */
	@supports (interpolate-size: allow-keywords) {
		:root {
			interpolate-size: allow-keywords;
		}
		.faq-item::details-content {
			height: 0;
			overflow: clip;
			opacity: 0;
			transition:
				height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
				opacity 0.3s ease,
				content-visibility 0.35s allow-discrete;
		}
		.faq-item[open]::details-content {
			height: auto;
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.faq-item::details-content {
			transition: none;
		}
	}
</style>
