---
import { url } from '@/lib/url';
import Layout from '@/layouts/Layout.astro';
import { MeeshoToolApp } from '@/components/tool/MeeshoToolApp';

const title = 'Meesho Label Cropper — Crop, Resize & Sort Labels Free';
const description =
	'Crop the tax invoice off your Meesho shipping labels, resize them for 3x5" or 4x6" printers, and sort by SKU or courier — free, in your browser, no login.';

const toolOptions = [
	{ label: 'Printer type', detail: 'Label printer (3x5" / 4x6") or A4 sheet, multiple labels per page.' },
	{ label: 'Invoice handling', detail: 'Crop the invoice away, or keep it as a separate downloadable PDF.' },
	{ label: 'Sort order', detail: 'Original order, by SKU, or by courier — match how you pack.' },
	{ label: 'Custom text & order #', detail: 'Stamp a note or the order number onto each label.' },
	{ label: 'SKU order summary', detail: 'A downloadable count of every SKU across the batch, for packing.' },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Meesho Label Cropper',
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Any (runs in browser)',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
	description,
};
---

<Layout title={title} description={description} schema={schema}>
	<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
		<div class="mx-auto max-w-2xl text-center">
			<h1 data-reveal class="text-4xl font-bold tracking-tight sm:text-5xl">Meesho Label Cropper</h1>
			<p data-reveal class="mt-4 text-lg text-muted-foreground">
				Upload your Meesho shipping label PDF, crop away the tax invoice, resize for your printer,
				and sort your labels the way you pack — free, with nothing ever leaving your browser.
			</p>
		</div>

		<div data-reveal class="mt-10">
			<MeeshoToolApp client:load />
		</div>

		<div data-reveal class="mx-auto mt-16 max-w-3xl">
			<h2 class="text-center text-2xl font-semibold tracking-tight">What you can configure</h2>
			<dl class="mt-8 grid gap-6 sm:grid-cols-2">
				{toolOptions.map((opt) => (
					<div class="rounded-xl border border-border bg-card p-5">
						<dt class="font-medium">{opt.label}</dt>
						<dd class="mt-1.5 text-sm text-muted-foreground">{opt.detail}</dd>
					</div>
				))}
			</dl>
		</div>

		<div data-reveal class="mx-auto mt-16 max-w-2xl rounded-xl border border-border bg-muted/30 p-6 text-center">
			<p class="text-sm text-muted-foreground">
				Have questions about how this works, or whether your data is safe? See the
				<a href={url('/faq')} class="font-medium text-foreground underline underline-offset-2">FAQ</a>
				or <a href={url('/how-it-works')} class="font-medium text-foreground underline underline-offset-2">how it works</a>.
			</p>
		</div>
	</section>
</Layout>
