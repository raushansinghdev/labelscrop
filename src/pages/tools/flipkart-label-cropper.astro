---
import { url } from '@/lib/url';
import Layout from '@/layouts/Layout.astro';

const title = 'Flipkart Label Cropper — Coming Soon';
const description =
	'A free, browser-only Flipkart shipping label cropper and sorter is on the LabelsCrop roadmap. See what it will do and try the Meesho label cropper today.';
---

<Layout title={title} description={description}>
	<section class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6 sm:py-28">
		<p data-reveal class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
			On the roadmap
		</p>
		<h1 data-reveal class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl">Flipkart Label Cropper</h1>
		<p data-reveal class="mt-4 text-lg text-muted-foreground">
			We're bringing the same free, browser-only cropping and sorting LabelsCrop offers for Meesho
			to Flipkart shipping labels. No login, no uploads to a server, no watermark — same as always.
		</p>
		<div data-reveal class="mt-8">
			<a
				href={url('/tools/meesho-label-cropper')}
				class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-6 py-3 text-base font-semibold text-primary-foreground shadow-sm transition-transform duration-150 hover:scale-[1.02] active:scale-[0.98]"
			>
				Try the Meesho Label Cropper
			</a>
		</div>
	</section>
</Layout>
