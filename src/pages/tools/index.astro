---
import ToolsHub, { type HubTool } from '@/components/tools/ToolsHub.astro';
import { alternates } from '@/lib/i18n';

const iconAttrs =
	'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"';

const tools: HubTool[] = [
	{
		path: '/tools/meesho-label-cropper',
		name: 'Meesho Label Cropper',
		pitch:
			'Turn the supplier panel’s label PDF into a clean, print-ready file, in the order you actually pack.',
		points: [
			'Tax invoice cropped off every label',
			'3x5" and 4x6" thermal, or 1 / 2 / 4 per A4 sheet',
			'Sort by SKU, courier, pickup hub or colour and size',
			'An SKU pick list of what to pack',
		],
		cta: 'Crop my labels',
		icon: `<svg ${iconAttrs}><path d="M6 2v14a2 2 0 0 0 2 2h14M18 22V8a2 2 0 0 0-2-2H2"/></svg>`,
	},
	{
		path: '/tools/meesho-profit-calculator',
		name: 'Meesho Profit Calculator',
		pitch: 'Read your payment file and find out what the month actually earned — which Meesho never tells you.',
		points: [
			'Starts from the real Final Settlement Amount',
			'Per-SKU margin once you add your costs',
			'Ads spend, RTO and returns subtracted honestly',
			'Rent, salaries and bills apportioned by period',
		],
		cta: 'Check my profit',
		icon: `<svg ${iconAttrs}><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
	},
	{
		path: '/tools/amazon-label-cropper',
		name: 'Amazon Label Cropper',
		pitch: 'The same cropping and sorting for Amazon shipping labels.',
		soon: true,
		points: [],
		cta: '',
		icon: `<svg ${iconAttrs}><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>`,
	},
	{
		path: '/tools/flipkart-label-cropper',
		name: 'Flipkart Label Cropper',
		pitch: 'The same cropping and sorting for Flipkart shipping labels.',
		soon: true,
		points: [],
		cta: '',
		icon: `<svg ${iconAttrs}><path d="M20 7H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1Z"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>`,
	},
];
---

<ToolsHub
	locale="en"
	title="Free Tools for Meesho Sellers — Label Cropper & Profit Calculator"
	description="Free Meesho seller tools: a label cropper for thermal and A4 printers, and a profit calculator that reads your payment file. No login, nothing uploaded."
	eyebrow="Tools"
	heading="Everything between the order and the answer"
	intro="One tool for the day the parcels go out, one for the day the money lands. Both free, both run entirely in your browser, and neither asks you to sign up."
	tools={tools}
	liveHeading="Ready to use"
	soonHeading="On the roadmap"
	soonIntro="The engine underneath is marketplace-agnostic, so these are adapters rather than rewrites. They ship when they have been tested against real labels — not before, because a cropper that gets the cut wrong is worse than no cropper."
	soonLabel="Coming soon"
	ctaTitle="Start with whichever came up today"
	ctaText="Packing this afternoon, or reconciling last month — both are free and neither needs an account."
	alternates={alternates({ en: '/tools', 'hi-Latn': '/tools' })}
/>
