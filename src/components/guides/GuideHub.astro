---
/**
 * The guides index, in one locale. Shared by `/guides` and `/hi/guides`.
 *
 * Grouped by cluster rather than listed by date: these are reference pages, and a seller arrives
 * looking for a subject ("printing", "payments"), not for whatever was written most recently.
 * The cluster headings are also the internal-linking spine — every guide links up to this page
 * and sideways to its cluster siblings.
 */
import Layout from '@/layouts/Layout.astro';
import PageCta from '@/components/site/PageCta.astro';
import { url } from '@/lib/url';
import { abs, breadcrumbs, ids } from '@/lib/schema';
import { localePath, type Alternate, type Locale } from '@/lib/i18n';
import {
	CLUSTERS,
	bcp47,
	cluster as clusterInfo,
	formatDate,
	guidePath,
	publishedGuides,
	type ClusterKey,
} from '@/lib/guides';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	eyebrow: string;
	heading: string;
	intro: string;
	updatedLabel: string;
	ctaTitle: string;
	ctaText: string;
	alternates: Alternate[];
}

const props = Astro.props;
const { locale } = props;

const guides = await publishedGuides(locale);
const path = localePath('/guides', locale);

/* Grouped in the order the clusters are declared, so the hub reads the same way every time
   regardless of what was published last. Empty clusters simply do not render. */
const grouped = (Object.keys(CLUSTERS) as ClusterKey[])
	.map((key) => ({ key, ...clusterInfo(key, locale), items: guides.filter((g) => g.data.cluster === key) }))
	.filter((group) => group.items.length > 0);

const schema = [
	breadcrumbs(Astro.site, [{ name: props.eyebrow, path }], locale),
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		name: props.title,
		description: props.description,
		url: abs(path, Astro.site),
		publisher: { '@id': ids.organization(Astro.site) },
		itemListElement: guides.map((guide, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: guide.data.title,
			url: abs(guidePath(guide), Astro.site),
		})),
	},
];
---

<Layout
	title={props.title}
	description={props.description}
	schema={schema}
	locale={bcp47(locale)}
	alternates={props.alternates}
>
	<section class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-6 sm:pt-16 sm:pb-24">
		<div class="text-center">
			<p data-reveal class="inline-flex rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
				{props.eyebrow}
			</p>
			<h1 data-reveal class="mt-4 text-3xl font-bold tracking-tight text-balance sm:text-5xl">{props.heading}</h1>
			<p data-reveal class="mx-auto mt-3 max-w-xl text-base text-pretty text-muted-foreground sm:mt-4 sm:text-lg">
				{props.intro}
			</p>
		</div>

		{
			grouped.map((group) => (
				<div class="mt-12 sm:mt-14">
					<h2 data-reveal class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">
						{group.label}
					</h2>
					<p data-reveal class="mt-1.5 text-sm text-muted-foreground">{group.blurb}</p>
					<ul class="mt-5 space-y-3">
						{group.items.map((guide) => (
							<li data-reveal>
								<a
									href={url(guidePath(guide))}
									class="block rounded-2xl border border-border bg-card p-5 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-primary/30"
								>
									<h3 class="font-semibold">{guide.data.title}</h3>
									<p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{guide.data.description}</p>
									<p class="mt-3 text-xs text-muted-foreground">
										{props.updatedLabel}{' '}
										<time datetime={guide.data.updated.toISOString()}>{formatDate(guide.data.updated)}</time>
									</p>
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}

		<PageCta title={props.ctaTitle} text={props.ctaText} />
	</section>
</Layout>
