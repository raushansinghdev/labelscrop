---
import { feedbackMailto } from '@/lib/feedback';
import { url } from '@/lib/url';

interface Props {
	title?: string;
	text?: string;
}

const {
	title = 'Ready to print your labels?',
	text = 'Free, no login, and your files never leave your device. Missing something? Tell us and we’ll look into it.',
} = Astro.props;

const feedbackHref = feedbackMailto(new URL(Astro.url.pathname, Astro.site).href);
---

<div
	data-reveal
	class="relative mt-16 overflow-hidden rounded-3xl border border-border bg-gradient-to-br from-primary/[0.07] via-background to-background p-6 text-center sm:p-10"
>
	<h2 class="text-2xl font-bold tracking-tight text-balance">{title}</h2>
	<p class="mx-auto mt-2 max-w-md text-sm text-pretty text-muted-foreground sm:text-base">{text}</p>
	<div class="mt-6 flex flex-col items-stretch justify-center gap-2.5 sm:flex-row sm:items-center">
		<a
			href={url('/tools/meesho-label-cropper')}
			class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-primary px-6 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 transition-transform duration-150 hover:-translate-y-0.5 active:translate-y-0"
		>
			Open the tool
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
				<path d="M5 12h14M13 6l6 6-6 6" />
			</svg>
		</a>
		<a
			href={feedbackHref}
			data-feedback-link
			class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-border bg-background px-6 text-base font-semibold transition-colors duration-150 hover:border-primary/40 hover:text-primary"
		>
			Request a feature
		</a>
	</div>
</div>
