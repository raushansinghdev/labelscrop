---
import { feedbackMailto } from '@/lib/feedback';
import { url } from '@/lib/url';

interface Props {
	title?: string;
	text?: string;
}

const {
	title = 'Two tools, one workflow',
	text = 'Free, no login, and your files never leave your device. Missing something? Tell us and we’ll look into it.',
} = Astro.props;

const feedbackHref = feedbackMailto(new URL(Astro.url.pathname, Astro.site).href);

/*
 * Both tools, always — this block closes every explainer page, and a site that hosts two tools
 * should not end each page pointing at one of them. Which is "primary" is decided by weight
 * rather than by the page: the cropper is what most people arrive for, the calculator is what
 * they find next.
 */
const arrow =
	'<svg data-arrow viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---

<div
	data-reveal
	class="relative mt-16 overflow-hidden rounded-3xl border border-border bg-gradient-to-br from-primary/[0.07] via-background to-background p-6 text-center sm:p-10"
>
	<h2 class="text-2xl font-bold tracking-tight text-balance">{title}</h2>
	<p class="mx-auto mt-2 max-w-md text-sm text-pretty text-muted-foreground sm:text-base">{text}</p>
	<div class="mt-6 flex flex-col items-stretch justify-center gap-2.5 sm:flex-row sm:items-center">
		<a
			href={url('/tools/meesho-label-cropper')}
			class="press nudge inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-primary px-6 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/30"
		>
			Crop my labels
			<Fragment set:html={arrow} />
		</a>
		<a
			href={url('/tools/meesho-profit-calculator')}
			class="press nudge inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-border bg-background px-6 text-base font-semibold hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
		>
			Check my profit
			<Fragment set:html={arrow} />
		</a>
	</div>
	<p class="mt-4 text-sm text-muted-foreground">
		Missing something?{' '}
		<a
			href={feedbackHref}
			data-feedback-link
			class="font-medium text-primary underline-offset-4 hover:underline">Request a feature</a
		>
	</p>
</div>
