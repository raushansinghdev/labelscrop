---
import { url } from '@/lib/url';
const year = new Date().getFullYear();

const columns = [
	{
		heading: 'Tools',
		links: [
			{ href: url('/tools/meesho-label-cropper'), label: 'Meesho Label Cropper' },
			{ href: url('/tools/meesho-profit-calculator'), label: 'Meesho Profit Calculator' },
			{ href: url('/tools/amazon-label-cropper'), label: 'Amazon Label Cropper (soon)' },
			{ href: url('/tools/flipkart-label-cropper'), label: 'Flipkart Label Cropper (soon)' },
		],
	},
	{
		heading: 'Learn',
		links: [
			{ href: url('/how-it-works'), label: 'How it Works' },
			{ href: url('/faq'), label: 'FAQ' },
			{ href: url('/about'), label: 'About' },
		],
	},
	{
		heading: 'Legal',
		links: [
			{ href: url('/privacy-policy'), label: 'Privacy Policy' },
			{ href: url('/terms'), label: 'Terms of Use' },
		],
	},
];
---

<footer class="border-t border-border/80 bg-muted/30">
	<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
		<div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
			<div class="md:col-span-1">
				<a href={url('/')} class="flex items-center gap-2 font-semibold tracking-tight">
					<span class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-primary-foreground" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M6 3h9l5 5v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z" />
							<path d="M14 3v5h5" />
						</svg>
					</span>
					LabelsCrop
				</a>
				<p class="mt-3 max-w-xs text-sm text-muted-foreground">
					Free, browser-only tools for Indian e-commerce sellers — print-ready labels and the
					profit behind them. Your files never leave your device.
				</p>
			</div>

			{columns.map((col) => (
				<div>
					<h3 class="text-sm font-semibold text-foreground">{col.heading}</h3>
					<ul class="mt-3 space-y-2">
						{col.links.map((link) => (
							<li>
								<a href={link.href} class="text-sm text-muted-foreground transition-colors hover:text-foreground">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>

		<div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-border/80 pt-6 sm:flex-row">
			<p class="text-xs text-muted-foreground">&copy; {year} LabelsCrop. Free forever.</p>
			<p class="text-xs text-muted-foreground">Not affiliated with Meesho, Amazon, or Flipkart.</p>
		</div>
	</div>
</footer>
