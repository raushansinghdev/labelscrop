---
import { url } from '@/lib/url';
const year = new Date().getFullYear();

const columns = [
	{
		heading: 'Tools',
		links: [
			{ href: url('/tools/meesho-label-cropper'), label: 'Meesho Label Cropper' },
			{ href: url('/tools/meesho-profit-calculator'), label: 'Meesho Profit Calculator' },
			{ href: url('/tools/amazon-label-cropper'), label: 'Amazon Label Cropper (soon)' },
			{ href: url('/tools/flipkart-label-cropper'), label: 'Flipkart Label Cropper (soon)' },
		],
	},
	{
		heading: 'Learn',
		links: [
			{ href: url('/guides'), label: 'Guides' },
			{ href: url('/how-it-works'), label: 'How it Works' },
			{ href: url('/faq'), label: 'FAQ' },
			{ href: url('/about'), label: 'About' },
		],
	},
	{
		heading: 'Legal',
		links: [
			{ href: url('/privacy-policy'), label: 'Privacy Policy' },
			{ href: url('/terms'), label: 'Terms of Use' },
		],
	},
];
---

<footer transition:persist="site-footer" class="border-t border-border/80 bg-muted/30">
	<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
		<div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
			<div class="md:col-span-1">
				<a href={url('/')} class="press group flex items-center gap-2 font-semibold tracking-tight">
					{/* Same mark as the header, one size down; the tile clips the stroke that leaves it. */}
					<span class="brand-tile block h-7 w-7 overflow-hidden rounded-md bg-primary text-primary-foreground transition-transform duration-300 ease-out group-hover:-rotate-6 group-hover:scale-105" aria-hidden="true">
						<svg viewBox="0 0 48 48" class="h-full w-full" fill="none" stroke="currentColor" stroke-width="4.2" stroke-linecap="butt" stroke-linejoin="miter">
							<path d="M14.7 18 L19.8 30 L24 22.2 L28.2 30 L40.8 1.2" />
						</svg>
					</span>
					SellerWala
				</a>
				<p class="mt-3 max-w-xs text-sm text-muted-foreground">
					Free, browser-only tools for Indian e-commerce sellers — print-ready labels and the
					profit behind them. Your files never leave your device.
				</p>
			</div>

			{columns.map((col) => (
				<div>
					<h3 class="text-sm font-semibold text-foreground">{col.heading}</h3>
					<ul class="mt-3 space-y-2">
						{col.links.map((link) => (
							<li>
								<a href={link.href} class="inline-block text-sm text-muted-foreground transition-[color,transform] duration-200 ease-[var(--ease-fluid)] hover:translate-x-0.5 hover:text-foreground active:text-foreground">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>

		<div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-border/80 pt-6 sm:flex-row">
			<p class="text-xs text-muted-foreground">&copy; {year} SellerWala. Free forever.</p>
			<p class="text-xs text-muted-foreground">Not affiliated with Meesho, Amazon, or Flipkart.</p>
		</div>
	</div>
</footer>

<style>
	/* Matches the header tile — one step down from --primary, so it reads as depth, not a
	 * second colour. Geometry for the mark itself lives in `scripts/icons.mjs`. */
	.brand-tile {
		background-image: linear-gradient(
			135deg,
			var(--primary),
			color-mix(in oklch, var(--primary) 62%, black)
		);
	}
</style>
