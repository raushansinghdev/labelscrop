---
/**
 * The downward half of hub-and-spoke linking: a tool page listing the guides that belong to it.
 *
 * Guides already link up to their tool, which on its own builds a funnel that only runs one way —
 * a visitor who lands on a tool page has no route into the written content, and the guides
 * accumulate no internal links from the pages that actually have authority. This closes the loop.
 *
 * Renders nothing at all when a tool has no guides yet, so it can be dropped onto a tool page
 * before the guides for it exist.
 */
import { url } from '@/lib/url';
import { cluster, guidePath, publishedGuides, type Guide } from '@/lib/guides';
import { DEFAULT_LOCALE, UI, localePath, type Locale } from '@/lib/i18n';

interface Props {
	tool: NonNullable<Guide['data']['tool']>;
	heading?: string;
	intro?: string;
	limit?: number;
	/**
	 * Which language's guides to list. A Hinglish tool page linking into English guides would
	 * drop the reader out of their own language, and `guidePath()` keeps the `/hi/` prefix on
	 * the links so the two never have to be kept in step by hand.
	 */
	locale?: Locale;
}

const { tool, heading = 'Read more', intro, limit = 3, locale = DEFAULT_LOCALE } = Astro.props;

const guides = (await publishedGuides(locale)).filter((g) => g.data.tool === tool).slice(0, limit);
---

{
	guides.length > 0 && (
		<div class="mx-auto max-w-3xl">
			<h2 data-reveal class="text-center text-2xl font-semibold tracking-tight">
				{heading}
			</h2>
			{intro && (
				<p data-reveal class="mx-auto mt-3 max-w-xl text-center text-sm text-pretty text-muted-foreground">
					{intro}
				</p>
			)}
			<ul class="mt-8 space-y-3">
				{guides.map((guide) => (
					<li data-reveal>
						<a
							href={url(guidePath(guide))}
							class="block rounded-2xl border border-border bg-card p-5 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-primary/30"
						>
							<span class="text-xs font-semibold text-primary">{cluster(guide.data.cluster, locale).label}</span>
							<span class="mt-1 block font-semibold">{guide.data.title}</span>
							<span class="mt-1 block text-sm leading-relaxed text-muted-foreground">
								{guide.data.description}
							</span>
						</a>
					</li>
				))}
			</ul>
			<p data-reveal class="mt-6 text-center text-sm">
				<a
					href={url(localePath('/guides', locale))}
					class="font-medium text-primary underline-offset-4 hover:underline"
				>
					{UI[locale].allGuides}
				</a>
			</p>
		</div>
	)
}
