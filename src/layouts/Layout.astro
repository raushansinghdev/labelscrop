---
import { url } from '@/lib/url';
import { SITE } from '@/lib/site';
import { organization, website } from '@/lib/schema';
import { LOCALES, type Alternate } from '@/lib/i18n';
import { ClientRouter } from 'astro:transitions';
import type { TransitionDirectionalAnimations } from 'astro';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import LangSwitch from '@/components/site/LangSwitch.astro';
import '@/styles/global.css';
/*
 * The Latin subset's URL, imported so the preload below points at the same hashed asset the
 * stylesheet requests — hard-coding the filename would break on the next content hash.
 *
 * Only this one subset is preloaded. The package also ships Cyrillic, Cyrillic-ext, Latin-ext and
 * Vietnamese subsets, but `unicode-range` means a browser never downloads those for English or
 * romanized Hindi, and preloading a file the page will not use is a wasted request competing with
 * the one it will.
 */
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
	title: string;
	description: string;
	/** One or more JSON-LD objects to emit as <script type="application/ld+json"> */
	schema?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
	/**
	 * Root-absolute path to this page's share image. Defaults to the site-wide card.
	 * Per-page images matter most for the two tool pages, which are what actually gets
	 * pasted into WhatsApp seller groups.
	 */
	ogImage?: string;
	/**
	 * BCP-47 tag for `<html lang>`. Defaults to `en-IN` rather than bare `en`, to agree with what
	 * every piece of structured data on the site already declares — and because the region is
	 * true: this is written for sellers in India. `hi-Latn` is the tag for romanized Hindi pages;
	 * the script subtag is what distinguishes "meesho label crop kaise kare" written in Roman
	 * letters from both English and Devanagari Hindi.
	 */
	locale?: string;
	/**
	 * This page's translations, from `alternates()` in `lib/i18n.ts`. Empty when the page exists
	 * in one language only, which is most of them.
	 */
	alternates?: Alternate[];
}

const {
	title,
	description,
	schema,
	noindex = false,
	ogImage = '/og/default.png',
	locale = 'en-IN',
	alternates = [],
} = Astro.props;

/*
 * The page swap. Astro's built-in `fade` cross-dissolves, which on a site whose pages share a
 * header and a footer reads as a flicker rather than a move. This pairs a quick exit with a
 * longer entrance on the house curve, so the outgoing page gets out of the way before the new
 * one settles — the same shape as the stage swaps inside both tools.
 */
const pageSwap: TransitionDirectionalAnimations = {
	forwards: {
		old: { name: 'page-out', duration: '0.16s', easing: 'var(--ease-exit)', fillMode: 'both' },
		new: { name: 'page-in', duration: '0.38s', easing: 'var(--ease-fluid)', fillMode: 'both' },
	},
	backwards: {
		old: { name: 'page-out', duration: '0.16s', easing: 'var(--ease-exit)', fillMode: 'both' },
		new: { name: 'page-in-back', duration: '0.38s', easing: 'var(--ease-fluid)', fillMode: 'both' },
	},
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(url(ogImage), Astro.site);

/*
 * `og:locale` wants an underscore form (`hi_IN`), `hreflang` wants the BCP-47 tag. Looking the
 * page's locale up here keeps both spellings in `lib/i18n.ts` rather than string-mangling the
 * tag at the point of use, which is how `hi-Latn` previously became the invalid `hi_Latn`.
 */
const localeMeta = (Object.values(LOCALES) as { tag: string; ogLocale: string }[]).find(
	(entry) => entry.tag === locale,
);
const ogLocale = localeMeta?.ogLocale ?? 'en_IN';

/*
 * Site-wide identity first, then whatever the page adds.
 *
 * Organization and WebSite used to live on the home page alone, which left every other URL —
 * including both tool pages, the ones that actually rank — with no declared publisher. Emitting
 * them everywhere costs a few hundred bytes of head and gives every page something to hang its
 * `publisher` / `isPartOf` reference on. The `@id`s in `lib/schema.ts` keep it one entity rather
 * than one copy per page.
 */
const pageSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemaList = [organization(Astro.site), website(Astro.site), ...pageSchema];
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#ffffff" />
		<!-- The SVG is what modern browsers pick. The .ico is the fallback. -->
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
		<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
		<link rel="manifest" href={url('/site.webmanifest')} />
		<!-- The font is self-hosted and declared `font-display: swap`, so text is never invisible —
		     but without this the request does not start until the stylesheet has been parsed, and
		     the fallback face is shown for that much longer. `crossorigin` is required on font
		     preloads even same-origin; without it the browser fetches the file a second time. -->
		<link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin />

		<!-- Indexable pages only. On a noindex page a canonical is a contradictory signal, and on the
		     404 it named `/404/`, a URL that doesn't exist. -->
		{!noindex && <link rel="canonical" href={canonicalURL} />}

		<!-- Reciprocal language annotations. Each locale's list includes itself and an x-default;
		     a non-reciprocal set is ignored outright, so the self-reference is load-bearing. -->
		{alternates.map((alt) => (
			<link rel="alternate" hreflang={alt.hreflang} href={new URL(url(alt.path), Astro.site)} />
		))}

		<!-- Both tools are heavy client-side work on a phone, and "add to home screen" is a
		     realistic way a seller returns to them daily. The manifest above is what makes that
		     offer appear at all. -->
		<meta name="apple-mobile-web-app-title" content={SITE.name} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- The share card. WhatsApp is the main sharing channel for Indian sellers and it reads
		     the OG tags, so `og:image` is not a nicety here — without it every link forwarded
		     into a seller group renders as a grey text stub. `summary_large_image` is what turns
		     it into a full-width card rather than a thumbnail. Dimensions are declared so the
		     card reserves the right space before the image finishes loading. -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<meta name="generator" content={Astro.generator} />

		{schemaList.map((entry) => (
			<script type="application/ld+json" set:html={JSON.stringify(entry)} />
		))}

		<ClientRouter />

		<script is:inline>
			/*
			 * The motion gate. Everything the stylesheet hides on scroll-reveal is scoped to
			 * `html[data-motion]`, so this one line is what gives the CSS permission to hide
			 * anything at all. It is deliberately inline and un-deferred: it has to win the race
			 * against first paint, or content flashes in and then hides itself.
			 *
			 * The flip side is the guarantee it buys — if this script never runs (blocked, old
			 * browser, parse error), no `[data-reveal]` element is ever hidden and the page reads
			 * exactly as it does with JavaScript off.
			 */
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.dataset.motion = '';
			}
		</script>
	</head>
	<body class="flex min-h-screen flex-col bg-background text-foreground antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
		>
			Skip to content
		</a>
		<div id="page-progress" aria-hidden="true"></div>

		<!-- The chrome persists across view transitions rather than being torn down and rebuilt on
		     every navigation: a header that blinks once per page is the thing that makes a
		     multi-page site feel like a multi-page site. `transition:persist` keeps the real DOM
		     node, so the sticky header never re-mounts, the mobile menu keeps its state, and the
		     scroll-progress bar above keeps running. The cost is that the header's active-link
		     state is no longer re-rendered by the server — Header.astro updates it on
		     `astro:page-load` instead. -->
		<Header />
		<main id="main-content" class="flex-1" transition:animate={pageSwap}>
			<slot />
		</main>
		<script is:inline>
			/*
			 * Starts the first screen's fade-in as soon as <main> is parsed, rather than when the
			 * module below runs.
			 *
			 * That module runs after the page's other modules, the tool bundles included, so on a
			 * throttled phone the heading and intro (each page's LCP element) sat invisible until
			 * the JS arrived: 4.0s LCP on the profit calculator. Running this part inline, mid-parse,
			 * keeps the same fade and stagger but starts it within a frame of the text arriving.
			 * The module still handles everything below the fold, and skips what is queued here.
			 *
			 * getBoundingClientRect forces a style pass with the elements still hidden, which is
			 * what gives the transition a starting point. The 70/280ms stagger mirrors
			 * REVEAL_STEP_MS and REVEAL_MAX_DELAY_MS in the module; an inline script cannot import
			 * them.
			 */
			(() => {
				if (!document.documentElement.hasAttribute('data-motion')) return;
				const onScreen = [...document.querySelectorAll('[data-reveal]:not(.is-visible)')].filter((el) => {
					const rect = el.getBoundingClientRect();
					return rect.top < innerHeight && rect.bottom > 0;
				});
				for (const el of onScreen) el.setAttribute('data-reveal-queued', '');
				requestAnimationFrame(() =>
					onScreen.forEach((el, index) => {
						el.style.setProperty('--reveal-delay', `${Math.min(index * 70, 280)}ms`);
						el.classList.add('is-visible');
					}),
				);
			})();
		</script>
		{/* Above the footer, not inside it: the footer is `transition:persist`ed, so anything
		    page-specific placed in it would keep the previous page's links after a navigation. */}
		<LangSwitch alternates={alternates} current={locale} />
		<Footer />

		<script>
			const REVEAL_STEP_MS = 70;
			const REVEAL_MAX_DELAY_MS = 280;

			/**
			 * Staggers a set of elements that arrive together, so a grid of cards cascades instead
			 * of flashing in as one block. The delay is a CSS custom property the stylesheet reads,
			 * rather than a timer per element — a dozen setTimeouts to do what one transition-delay
			 * already does is a dozen chances to fire during a scroll.
			 */
			function revealAll(els: HTMLElement[]) {
				els.forEach((el, index) => {
					el.style.setProperty(
						'--reveal-delay',
						`${Math.min(index * REVEAL_STEP_MS, REVEAL_MAX_DELAY_MS)}ms`,
					);
					el.classList.add('is-visible');
				});
			}

			function initReveal() {
				// Queued elements are the first screen, already being faded in by the inline script
				// after <main>.
				const els = [
					...document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible):not([data-reveal-queued])'),
				];
				if (els.length === 0) return;

				/*
				 * Anything already on screen is revealed immediately, before a single scroll event.
				 *
				 * This is not an optimisation, it is the fix for a real bug: the observer alone used
				 * a 0.15 threshold, so an element poking a few percent above the fold — which is
				 * exactly where the home page's two tool cards sat at 1280x900 — never reached the
				 * threshold and never revealed. The bottom of the first screen was blank white until
				 * the visitor happened to scroll. Being in the viewport at all is the condition now.
				 */
				const onScreen: HTMLElement[] = [];
				const offScreen: HTMLElement[] = [];
				for (const el of els) {
					const rect = el.getBoundingClientRect();
					(rect.top < window.innerHeight && rect.bottom > 0 ? onScreen : offScreen).push(el);
				}
				// Next frame, not this one: the elements must paint hidden once for the transition
				// to have somewhere to travel from. Setting the class in the same frame as first
				// paint skips the animation entirely.
				requestAnimationFrame(() => revealAll(onScreen));

				if (offScreen.length === 0) return;
				if (!('IntersectionObserver' in window)) {
					revealAll(offScreen);
					return;
				}

				// `-8%` at the bottom starts the reveal a little before the element reaches the
				// very edge of the screen, so it is already settling by the time it is being read.
				const io = new IntersectionObserver(
					(entries) => {
						const arrived = entries
							.filter((entry) => entry.isIntersecting)
							.map((entry) => entry.target as HTMLElement);
						if (arrived.length === 0) return;
						// Stagger by document order within the batch, not observer-callback order,
						// which is unspecified — otherwise a row of cards cascades right-to-left
						// about half the time.
						arrived.sort((a, b) =>
							a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1,
						);
						revealAll(arrived);
						for (const el of arrived) io.unobserve(el);
					},
					{ threshold: 0, rootMargin: '0px 0px -8% 0px' },
				);
				offScreen.forEach((el) => io.observe(el));
			}

			/**
			 * Header elevation and the scroll-progress bar, both driven by a 1px sentinel at the top
			 * of the document rather than a scroll listener. An observer that fires twice per visit
			 * costs nothing; a scroll handler runs on every frame of every scroll for the same
			 * two-state answer.
			 */
			function initScrollState() {
				const root = document.documentElement;
				let sentinel = document.getElementById('scroll-sentinel');
				if (!sentinel) {
					sentinel = document.createElement('div');
					sentinel.id = 'scroll-sentinel';
					sentinel.setAttribute('aria-hidden', 'true');
					sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:1px;pointer-events:none';
					document.body.prepend(sentinel);
					new IntersectionObserver(
						([entry]) => root.toggleAttribute('data-scrolled', !entry.isIntersecting),
						{ threshold: 0 },
					).observe(sentinel);
				}
			}

			/**
			 * Drives the scroll-progress bar. Bound once for the lifetime of the document — the
			 * listener is on `window`, which view transitions do not replace.
			 */
			function initProgress() {
				let queued = false;
				const update = () => {
					queued = false;
					const max = document.documentElement.scrollHeight - window.innerHeight;
					const ratio = max > 0 ? window.scrollY / max : 0;
					document.documentElement.style.setProperty('--scroll-progress', String(Math.min(1, ratio)));
				};
				addEventListener(
					'scroll',
					() => {
						if (queued) return;
						queued = true;
						requestAnimationFrame(update);
					},
					{ passive: true },
				);
				update();
			}

			/*
			 * Navigation feedback. The bar only appears if the swap takes longer than a moment —
			 * with prefetch most navigations resolve in well under that, and a progress bar that
			 * flashes on every instant navigation reads as a glitch rather than as progress.
			 */
			let navTimer: ReturnType<typeof setTimeout> | undefined;
			document.addEventListener('astro:before-preparation', () => {
				clearTimeout(navTimer);
				navTimer = setTimeout(() => document.documentElement.toggleAttribute('data-navigating', true), 180);
			});
			const endNavigation = () => {
				clearTimeout(navTimer);
				document.documentElement.removeAttribute('data-navigating');
			};
			document.addEventListener('astro:after-swap', endNavigation);

			/*
			 * The swap replaces every attribute on <html> with the incoming page's, and the incoming
			 * page's inline head script never runs — so without this, `data-motion` vanished on the
			 * first navigation and every scroll reveal after it was silently switched off. Copied
			 * onto the new document before the swap, so there is no frame without it.
			 */
			document.addEventListener('astro:before-swap', (event) => {
				const root = event.newDocument.documentElement;
				if (document.documentElement.hasAttribute('data-motion')) root.setAttribute('data-motion', '');
			});

			function init() {
				initScrollState();
				initReveal();
			}

			initProgress();
			init();
			// Re-run for the newly swapped document after every view transition. The listeners above
			// are bound to `document`, which persists, so they are registered once and only once.
			document.addEventListener('astro:page-load', init);
		</script>
	</body>
</html>
